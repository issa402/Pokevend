# ============================================================
# PokémonTool — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file to source control!
# ============================================================

# ---- App ----
NODE_ENV=development
PORT=3001                          # Node.js API Gateway port
CLIENT_URL=http://localhost:5173   # React dev server URL

# ---- Security ----
JWT_SECRET=replace_with_a_long_random_string_at_least_64_chars
ENCRYPTION_KEY=replace_with_32_char_hex_key_for_aes256   # 32 bytes hex for AES-256

# ---- PostgreSQL (Relational DB) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pokemontool
POSTGRES_USER=pokemontool_user
POSTGRES_PASSWORD=replace_with_secure_password

# ---- MongoDB (Card & Listing Documents) ----
MONGO_URI=mongodb://localhost:27017/pokemontool

# ---- Redis (Cache & Sessions) ----
REDIS_URL=redis://localhost:6379

# ---- RabbitMQ (Message Queue between services) ----
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ---- eBay API (Free Developer Tier - register at developer.ebay.com) ----
EBAY_CLIENT_ID=your_ebay_app_client_id
EBAY_CLIENT_SECRET=your_ebay_app_client_secret
EBAY_SANDBOX_MODE=true            # Set to false for production eBay API
EBAY_NOTIFICATION_VERIFICATION_TOKEN=random_token_for_webhook_validation

# ---- TCGplayer API (Requires commercial agreement at tcgplayer.com/developers) ----
TCGPLAYER_PUBLIC_KEY=your_tcgplayer_public_key
TCGPLAYER_PRIVATE_KEY=your_tcgplayer_private_key

# ---- Eventbrite API (Free - register at eventbrite.com/platform) ----
EVENTBRITE_TOKEN=your_eventbrite_oauth_token

# ---- Facebook / Meta (No public API — using Playwright scraping) ----
# Optional: paste a Facebook session cookie to avoid re-login in scraper
FB_SESSION_COOKIE=

# ---- Scraping Service (Go) ----
SCRAPING_INTERVAL_MINUTES=30       # How often to re-scrape marketplaces
SCRAPING_HEADLESS=true             # Run browser headless (true for server)
SCRAPING_TIMEOUT_SECONDS=30

# ---- Analytics Engine (Python) ----
TREND_ANALYSIS_INTERVAL_HOURS=1    # How often to recalculate trends
DEAL_OF_DAY_HOUR=6                 # Hour (UTC) to compute daily deals
NEWS_SCAN_INTERVAL_MINUTES=30

# ---- Notification Settings ----
PRICE_ALERT_THRESHOLD_PERCENT=5    # Alert when price changes by this % or more
